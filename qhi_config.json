{
  "qhi_path": "C:\\Program Files (x86)\\Quite\\Quite Hot Imposing 5\\qi_applycommands.exe",
  "output_dir": "C:\\Users\\diy\\Desktop\\QHI_FinalFiles",
  "rename_enabled": true,
  "rename_template": "{seq}-{paper}-{pages}P-{name}",
  "number_digits": 3,
  "number_start": 1,
  "default_machine": "HP12000",
  "monitor_dirs": [
    {
      "root_path": "\\\\Server2\\客户文件2",
      "enabled": false,
      "check_interval": 300,
      "stable_minutes": 10,
      "days_back": 2,
      "auto_process": 1,
      "customer": "9705-小风"
    }
  ],
  "rules": [
    {
      "name": "封面处理",
      "enabled": true,
      "condition_type": "name_contains",
      "condition_value": "封面",
      "steps": [
        {"type": "preflight", "action": "check_bleed", "params": {"min_bleed_mm": 3.0}},
        {"type": "process", "action": "add_crop_marks", "params": {"style": "both"}},
        {"type": "output", "action": "set_printer", "params": {"printer": "hp_indigo"}}
      ]
    },
    {
      "name": "内文处理",
      "enabled": true,
      "condition_type": "name_contains",
      "condition_value": "内文",
      "steps": [
        {"type": "preflight", "action": "check_dpi", "params": {"min_dpi": 150}},
        {"type": "process", "action": "optimize_color", "params": {"mode": "cmyk"}},
        {"type": "output", "action": "set_printer", "params": {"printer": "oce_varioprint_6000"}}
      ]
    },
    {
      "name": "骑马钉书刊",
      "enabled": true,
      "condition_type": "machine_match",
      "condition_value": "骑马钉",
      "steps": [
        {"type": "preflight", "action": "check_page_count", "params": {"must_be_divisible_by": 4}},
        {"type": "process", "action": "gang_impose", "params": {"mode": "auto", "sheet_size": "A3"}},
        {"type": "finishing", "action": "saddle_stitch", "params": {"staples": 2}},
        {"type": "output", "action": "set_printer", "params": {"printer": "bizhub_287"}}
      ]
    }
  ],
  "ui_settings": {
    "window_width": 1280,
    "window_height": 800,
    "log_font_size": 12
  },
  "crop_marks_enabled": false,
  "crop_marks_style": "both",
  "crop_offset_mm": 3.0,
  "reg_marks_enabled": false,
  "reg_marks_style": "crosshair",
  "reg_marks_position": "all",
  "trapping_enabled": false,
  "trap_width_mm": 0.1,
  "trap_direction": "auto",
  "black_trap_enabled": false,
  "flatten_transparency": false,
  "flatten_dpi": 300,
  "ink_coverage_check": true,
  "max_ink_coverage": 320,
  "min_dpi": 150,
  "bleed_check": true,
  "min_bleed_mm": 3.0,
  "gwg_profile": "",
  "icc_profile": "FOGRA39",
  "convert_rgb_to_cmyk": true,
  "pantone_enabled": true,
  "pdfx_enabled": false,
  "pdfx_standard": "PDF/X-1a",
  "pdfx_embed_fonts": true,
  "max_workers": 4,
  "timeout_per_file": 300,
  "stop_on_error": false,
  "auto_archive": true,
  "api": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 18900
  },
  "ws_enabled": false,
  "ws_port": 18901,
  "jdf_hotfolder_enabled": false,
  "jdf_hotfolder_path": "",
  "jmf_push_enabled": false,
  "monitor_enabled": false,
  "monitor_stability_sec": 3,
  "printers": [
    {
      "id": "bizhub_287",
      "name": "bizhub 287",
      "ip": "192.168.1.32",
      "type": "multi_function",
      "capabilities": ["print", "copy", "scan", "fax"],
      "color": true,
      "duplex": true,
      "max_paper_size": "A3",
      "port": 9100,
      "protocol": "RAW",
      "enabled": true,
      "location": "工作区",
      "added_at": "2026-06-20"
    }
  ]
}