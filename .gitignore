# QHI Processor — Git Ignore
# ========================================

# 日志文件
logs/

# Python 编译文件
*.pyc
*.pyo
__pycache__/

# 敏感配置
config/indet_erp_config.json
config/printer_config.json
config/license.key

# 环境变量
.env

# 共享文件夹
shared/

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 临时文件
temp/
tmp/
*.tmp
*.temp

# 输出目录（可选，视项目需要）
# output/

# 测试文件
test_*.py
*_test.py

# 构建产物
dist/
build/
*.egg-info/
