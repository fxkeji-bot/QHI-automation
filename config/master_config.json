  },
  "api": {
    "host": "192.168.1.45",
    "port": 8088,
    "dashboard_endpoint": "/api/dashboard",
    "orders_endpoint": "/api/flow/orders",
    "fleet_status_endpoint": "/api/fleet/status",
    "stats_endpoint": "/api/stats/summary"
  }
